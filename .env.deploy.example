# Per-deployment config for `scripts/deploy.sh`. Copy this to
# `.env.deploy.<label>` (gitignored) for each domain you deploy this codebase
# to, e.g. `.env.deploy.cumuluselements`, then run:
#
#   npm run deploy -- cumuluselements
#
# Each label is a fully separate Worker deployment (own custom domain, own
# vars) sharing the same code. POLICY_AUD and SESSION_SECRET are NOT here —
# those stay Cloudflare secrets, set once via `wrangler secret put` and left
# alone by ordinary deploys.

# Custom domain this deployment serves. Must already exist as a zone on your
# Cloudflare account. Passed to `wrangler deploy --domain`.
DEPLOY_DOMAIN=mail.yourdomain.com

# Cloudflare Access team URL for this deployment (Zero Trust dashboard ->
# Settings -> Custom Pages, or your team's login URL). Not secret, but
# specific to this deployment.
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# The only identity allowed to reach /api/v1/admin/* for this deployment.
ADMIN_EMAIL=admin@yourdomain.com

# Forward address for mail to a mailbox with no provisioned account yet.
MASTER_NOTIFICATION_EMAIL=you@example.com

# Comma-separated domain(s) this deployment sends/receives mail for.
DOMAINS=yourdomain.com

# Comma-separated allow-list restricting which addresses can be provisioned.
# Empty = unrestricted.
EMAIL_ADDRESSES=

# Comma-separated shared/team mailbox addresses for this deployment.
SHARED_MAILBOX_ADDRESSES=
